{
  "name": "kaloscope-frontend",
  "version": "0.12.1",
  "description": "Frontend for Kaloscope project",
  "author": "Xylitol <jam.xylitol@gmail.com>",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "pwa-assets-generator && vite build",
    "build:icons": "tsx ./src/lib/icons/preload.ts && prettier --write ./src/lib/icons",
    "build:jsonc": "lezer-generator ./src/lib/grammars/jsonc.grammar -o ./src/lib/grammars/jsonc-parser.js",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --project ./src/pwa/tsconfig.json --noEmit",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource/audiowide": "^5.3.0",
    "@fontsource/zcool-qingke-huangyou": "^5.3.0",
    "@xyflow/svelte": "^1.7.0",
    "cally": "^0.9.2",
    "codemirror": "^6.0.2",
    "cropperjs": "^2.3.1",
    "iconify-icon": "^3.0.5",
    "ky": "^2.2.0",
    "marked": "^18.1.2",
    "svelte-i18n": "^4.0.1",
    "sveltekit-search-params": "^4.0.1",
    "tippy.js": "^6.3.7",
    "ua-parser-js": "^2.0.10",
    "uuid": "^14.0.3",
    "xgplayer": "^3.0.27",
    "xgplayer-flv": "^3.0.27",
    "xgplayer-hls": "^3.0.27",
    "xgplayer-mp4": "^3.0.27",
    "xgplayer-shaka": "^3.0.27",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lezer/generator": "^1.8.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@unplugin-pwa/core": "^0.0.3",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vite-pwa/sveltekit": "^2.0.0",
    "@vite-pwa/workbox-swkit": "^8.0.13",
    "@vite-pwa/workbox-window": "^8.0.13",
    "daisyui": "^5.7.50",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.14.0",
    "license-checker": "^25.0.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-devtools-json": "^1.1.2"
  }
}
